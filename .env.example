NEXT_PUBLIC_SUPABASE_URL=https://hkyvnilzcecdeecjimkz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_g40v1CEF8vkthRNU4JoxQg_Js2pxsHm

# Privada — NUNCA con prefijo NEXT_PUBLIC_. Solo se usa en rutas API del
# servidor para crear usuarios y resetear contraseñas desde /configuracion.
# Se saca del dashboard de Supabase: Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Privada — NUNCA con prefijo NEXT_PUBLIC_. Lee las reclamaciones con IA
# (Qwen-VL vía DashScope, Alibaba Cloud) para prellenar el formulario de
# digitación en vez de escribirlo todo a mano. Se saca gratis (cuenta
# internacional, tiene cuota de bienvenida) en:
# https://modelstudio.console.alibabacloud.com -> API Keys.
# Sin esta variable, la app sigue funcionando igual que antes: cada
# reclamación se digita a mano, sin bloquear nada.
DASHSCOPE_API_KEY=
# Opcionales — solo si se necesita cambiar de cuenta/modelo:
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-vl-max
